      color: white;
      padding: 20px;
      width: 250px;
      height: 150px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
      text-align: center;
    }

    footer {
      background-color: #000;
      color: #ccc;
      text-align: center;
      padding: 20px;
      font-size: 14px;
      border-top: 1px solid #333;
    }

    /* Ajout des media queries pour la responsivité */
    @media (max-width: 768px) {
      .service-container {
        flex-direction: column;
        align-items: center;
      }

      .service {
        width: 80%;
        height: auto;
      }
    }

    @media (max-width: 480px) {
      .intro p {
        font-size: 14px;
      }

      .intro button {
        font-size: 14px;
        padding: 8px 16px;
      }

      #services h2 {
        font-size: 24px;
      }
    }
  </style>
</head>
